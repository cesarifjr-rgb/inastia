# Inastia — Environment Variables
# Production credentials belong only in Vercel's production environment.
# Local tests mock all providers; do not copy production secrets here.

# Resend API Key (email sending via api/contact.js)
RESEND_API_KEY=

# Cloudflare Turnstile Secret Key (anti-spam verification)
TURNSTILE_SECRET_KEY=

# Optional additional exact Turnstile hostnames, comma-separated.
# inastia.fr and www.inastia.fr are always allowed by the server.
# Vercel previews and development deployments cannot send contact enquiries.
# Do not use wildcards or a value derived from an incoming request.
TURNSTILE_ALLOWED_HOSTNAMES=

# Server-only Attio token for accepted contact enquiries (production only).
# Requires Records read-write and Object configuration read access in Inastia.
ATTIO_API_KEY=
